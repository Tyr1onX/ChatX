{
  "manifest_version": 3,
  "name": "ChatX Watcher",
  "version": "0.1.0",
  "description": "极轻量监听 ChatGPT 对话完成状态，并在当前网页右下角显示提醒。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/selectors.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatX Watcher",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}

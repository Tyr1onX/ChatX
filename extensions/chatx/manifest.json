{
  "manifest_version": 3,
  "name": "ChatX",
  "version": "0.1.0",
  "description": "ChatX browser extension.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/session-guard/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/features.js",
        "src/session-guard/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/features.js",
        "src/watcher/selectors.js",
        "src/watcher/content.js",
        "src/agent-bridge/protocol.js",
        "src/agent-bridge/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/features.js",
        "src/watcher/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatX",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
